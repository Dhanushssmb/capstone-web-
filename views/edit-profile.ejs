<%- include('partials/header') %>
<main class="container page-wrap narrow-wrap">
    <div class="page-heading">
        <span class="eyebrow text-primary">YOUR PROFILE</span>
        <h1>Edit your details</h1>
        <p>Profile edits do not change your administrator approval status.</p>
    </div>

    <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger">
            <ul class="mb-0">
                <% errors.forEach(function(err) { %>
                    <li><%= err %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form method="post" action="<%= url('edit-profile') %>" enctype="multipart/form-data" class="panel-card">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
            <%- include('partials/profile-form', { profile: profile }) %>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary">Save profile</button>
                <a class="btn btn-outline-secondary" href="<%= url('dashboard') %>">Cancel</a>
            </div>
        </div>
    </form>
</main>
<%- include('partials/footer') %>

