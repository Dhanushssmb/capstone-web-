<%
const profileData = typeof profile !== 'undefined' && profile ? profile : {};
const currentYear = new Date().getFullYear();
%>
<div class="col-md-6">
    <label class="form-label" for="full_name">Full name</label>
    <input class="form-control" id="full_name" name="full_name" type="text" value="<%= profileData.full_name || '' %>" maxlength="120" required>
</div>
<div class="col-md-6">
    <label class="form-label" for="email">Email address</label>
    <input class="form-control" id="email" name="email" type="email" value="<%= profileData.email || '' %>" maxlength="190" required>
</div>
<div class="col-md-6">
    <label class="form-label" for="phone">Phone number</label>
    <input class="form-control" id="phone" name="phone" type="tel" value="<%= profileData.phone || '' %>" maxlength="30">
</div>
<div class="col-md-6">
    <label class="form-label" for="college_name">College name</label>
    <input class="form-control" id="college_name" name="college_name" type="text" value="<%= profileData.college_name || '' %>" maxlength="160" required>
</div>
<div class="col-md-6">
    <label class="form-label" for="department">Department</label>
    <input class="form-control" id="department" name="department" type="text" value="<%= profileData.department || '' %>" maxlength="120" required>
</div>
<div class="col-md-6">
    <label class="form-label" for="graduation_year">Graduation year</label>
    <input class="form-control" id="graduation_year" name="graduation_year" type="number" min="1950" max="<%= currentYear %>" value="<%= profileData.graduation_year || '' %>" required>
</div>
<div class="col-md-6">
    <label class="form-label" for="current_company">Current company</label>
    <input class="form-control" id="current_company" name="current_company" type="text" value="<%= profileData.current_company || '' %>" maxlength="160">
</div>
<div class="col-md-6">
    <label class="form-label" for="job_role">Job role</label>
    <input class="form-control" id="job_role" name="job_role" type="text" value="<%= profileData.job_role || '' %>" maxlength="160">
</div>
<div class="col-md-6">
    <label class="form-label" for="current_city">Current city</label>
    <input class="form-control" id="current_city" name="current_city" type="text" value="<%= profileData.current_city || '' %>" maxlength="120">
</div>
<div class="col-md-6">
    <label class="form-label" for="linkedin_url">LinkedIn profile URL</label>
    <input class="form-control" id="linkedin_url" name="linkedin_url" type="url" value="<%= profileData.linkedin_url || '' %>" maxlength="500" placeholder="https://linkedin.com/in/username">
</div>
<div class="col-12">
    <label class="form-label" for="bio">Short biography</label>
    <textarea class="form-control" id="bio" name="bio" rows="4" maxlength="1500"><%= profileData.bio || '' %></textarea>
    <div class="form-text">Share a little about your career and interests (up to 1,500 characters).</div>
</div>
<div class="col-12">
    <label class="form-label" for="profile_photo">Profile photo</label>
    <input class="form-control" id="profile_photo" name="profile_photo" type="file" accept="image/jpeg,image/png,image/gif,image/webp">
    <div class="form-text">JPEG, PNG, GIF, or WebP; maximum 2 MB.</div>
</div>

