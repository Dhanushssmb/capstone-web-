<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Reconnect with graduates, discover career journeys, and stay connected to your college community.">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Alumni Network' %> | Alumni Network</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="<%= url('assets/css/style.css') %>" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top border-bottom">
    <div class="container">
        <a class="navbar-brand" href="<%= url('/') %>"><span class="brand-mark">A</span> Alumni<span class="brand-light">Connect</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                <li class="nav-item"><a class="nav-link" href="<%= url('directory') %>">Directory</a></li>
                <% if (currentUser) { %>
                    <% if (currentUser.role === 'admin') { %>
                        <li class="nav-item"><a class="nav-link" href="<%= url('admin/dashboard') %>">Admin</a></li>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link" href="<%= url('dashboard') %>">Dashboard</a></li>
                    <% } %>
                    <li class="nav-item"><span class="nav-link text-secondary small"><%= currentUser.full_name %></span></li>
                    <li class="nav-item">
                        <form method="post" action="<%= url('logout') %>" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn-outline-primary btn-sm">Log out</button>
                        </form>
                    </li>
                <% } else { %>
                    <li class="nav-item"><a class="nav-link" href="<%= url('login') %>">Log in</a></li>
                    <li class="nav-item"><a class="btn btn-primary btn-sm px-3" href="<%= url('register') %>">Join the network</a></li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
<% if (flashMessage) { %>
    <div class="container pt-3">
        <div class="alert alert-<%= flashMessage.type %> alert-dismissible fade show" role="alert">
            <%= flashMessage.message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>

